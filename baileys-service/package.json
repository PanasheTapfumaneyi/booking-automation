{
  "name": "kivo-baileys-service",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone transactional WhatsApp transport for Kivo booking notifications (single session).",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  }
}
